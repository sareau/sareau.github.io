---
import '../styles/reset.css';
import '../styles/global.css';

// import Logo from './Logo.astro';
import Nav from './Nav.astro';

interface Props {
    current: string;
}

const { current } = Astro.props;
---

<div class="header-wrapper">
    <header>
        <Nav current={current} />
        <div class="heading-wrapper">
            <slot />
        </div>
    </header>
</div>
