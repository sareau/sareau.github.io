<style>
    .header-wrapper {
        width: 100%;
        padding: var(--spacer0);
        position: fixed;
        top: 0;
    }
    header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: var(--spacer0);
    }
    .heading-wrapper {
        padding: var(--spacer0);
        background-color: var(--color-background);
        border: 1px solid var(--color-foreground);
    }
    .heading-wrapper a {
        text-decoration: none;
    }
    .time {
        text-align: right;
    }
</style>

