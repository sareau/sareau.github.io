---
import '../styles/reset.css';
import '../styles/global.css';

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ButtonLink from '../components/ButtonLink.astro';

import json from './interests/favorites/_favorites.json';

const posts = Object.values(await import.meta.glob('./blog/*.md', { eager: true }));
const reviews = Object.values(await import.meta.glob('./interests/reviews/*.md', { eager: true }));
const works = Object.values(await import.meta.glob('./works/*.md', { eager: true } )) ;

posts.sort((a: any, b: any) => Date.parse(b.frontmatter.datePublish) - Date.parse(a.frontmatter.datePublish))
reviews.sort((a: any, b: any) => Date.parse(b.frontmatter.datePublish) - Date.parse(a.frontmatter.datePublish))
works.sort((a: any, b: any) => Date.parse(b.frontmatter.datePublish) - Date.parse(a.frontmatter.datePublish))
---

<Layout title="sareau" description="my tiny, little, miniscule, putrid, personal website.">
    <Header current="/" class:list={['header']}>
        <h1>sareau</h1>
    </Header>
    <div class="hero">
        <div class="welcome">
            <h2>welcome!</h2>
            <p>thanks for visiting !!!</p>
        </div>
    </div>
	<main>
		<div class="side">
			<section>
				<h2>status</h2>
				<div id="statuscafe">
					<div id="statuscafe-username"></div>
					<div id="statuscafe-content"></div>
				</div>
				<script src="https://status.cafe/current-status.js?name=sareau" defer is:inline></script>
			</section>
			<section>
				<h2>listening</h2>
				<p class="song"></p>
				<p class="artist"></p>
			</section>
			<section>
				<h2>neighbors</h2>
				<div class="neighbors">
					<a href="https://mwiron.neocities.org"><img src="/buttons/mwiron.gif" loading="lazy" /></a>
					<a href="https://kkiouji.neocities.org"><img src="/buttons/kkiouji.gif" loading="lazy" /></a>
					<a href="https://melankorin.net/"><img src="https://melankorin.net/assets/img/buttons/button-1.gif" loading="lazy" /></a>
					<a href="https://remblanc.nekoweb.org"><img src="https://remblanc.nekoweb.org/images/button.png" alt="remblanc" title="this quirk of my button link is not very likely to reach many of its users at this point" loading="lazy" /></a>
					<a href="https://dimden.dev/"><img src="https://dimden.dev/services/images/88x31.gif" loading="lazy" /></a>
					<a href="https://maia.crimew.gay"><img src="/buttons/maia.crimew.gay.png" loading="lazy" /></a>
					<a href="https://frajola.neocities.org/"><img src="https://frajola.neocities.org/images/frajola.gif" alt="frajola" loading="lazy" /></a>
				</div>
			</section>
			<section>
				<h2>link me</h2>
				<p>add my button if you want.</p>
				<div class="button-container">
					<img src="/button.png" alt="my button." loading="lazy" />
					<textarea readonly onclick="this.setSelectionRange(0, this.value.length)"><a href="https://sareau.github.io"><img src="https://sareau.github.io/button.png" alt="my button."/></a></textarea>
				</div>
			</section>
		</div>
		<div class="main">
			<section>
				<h2>about</h2>
				<div class="about">
					<div class="about-content">
						<p>hai, i'm sara[h] (she/her). i'm a chud cs major who can't do anything but code personal websites like this one. this place is for me to show off my interests and projects and also to bullshit.</p>
						<p>don't contact me (#leavemealone), but you can find me on these public platforms:</p>
						<ul class="profiles" role="list">
							<!-- <li><ButtonLink href="https://twitter.com/sareaus" label="twitter" /></li> -->
							<li><ButtonLink href="https://bsky.app/profile/sareau.bsky.social" label="bluesky" /></li>
							<li><ButtonLink href="https://letterboxd.com/sareau/" label="letterboxd" /></li>
							<!-- <li><ButtonLink href="https://cohost.org/sareau" label="cohost" /></li> -->
							<!-- <li><ButtonLink href="https://www.instagram.com/r.sareau/" label="instagram" /></li> -->
							<li><ButtonLink href="https://www.last.fm/user/sareau" label="last.fm" /></li>
							<li><ButtonLink href="https://rateyourmusic.com/~sareau" label="rym" /></li>
							<!-- <li><ButtonLink href="https://bandcamp.com/sareau" label="bandcamp" /></li> -->
							<li><ButtonLink href="https://www.discogs.com/user/sareau" label="discogs" /></li>
							<li><ButtonLink href="https://musescore.com/user/49324478" label="musescore" /></li>
						</ul>
					</div>
					<!-- <figure class="about-persona">
						<img src="/myself.png" alt="a picture of my persona, created by kkiouji.">
						<figcaption>a persona created for me by <a href="https://kkiouji.neocities.org">kkiouji</a>.</figcaption>
					</figure> -->
				</div>
			</section>
			<section>
				<h2 class="outlink"><a href="/blog/">blog</a></h2>
				<div class="blog">
    				<p>here are all of my blog posts, sharing whatever strong thoughts i have in the moment. don't expect a new marx or whoever out of me, yeah?</p>
    				<ul class="post-list" role="list">
    					{posts.map((post: any) =>
    						<li>
    							<p class="post-title"><a href={post.url}>{post.frontmatter.title}</a></p>
    							<p>{post.frontmatter.datePublish.slice(0, 10)}</p>
    						</li>
    					)}
    				</ul>
				</div>
			</section>
			<section>
				<h2>interests</h2>
				<div class="interests">
    				<p>to be rewritten #dontkillme</p>
				</div>
			</section>
			<section>
				<h2 class="outlink"><a href="/interests/favorites/">favorites</a></h2>
				<div class="favorites">
                    <p>i've got a lot of favorite pieces of media and not enough time to add them all to this website. You can visit the full page above or look at some of my favorite albums below (just a part of the list). they're in no particular order.</p>
    				<ul class="favorites-grid">
    					{json.albums.slice(0, 9).map((album) =>
    						<li>
    							<a href={album.link}>
    								<img src={album.image} alt={`${album.title} by ${album.artist}`} title={`${album.title} by ${album.artist}`} loading="lazy" />
    							</a>
    						</li>
    					)}
    				</ul>
				</div>
			</section>
			<section>
				<h2 class="outlink"><a href="/interests/reviews/">reviews</a></h2>
				<div class="reviews">
				    <p>here are long(ish)-form reviews of stuff i like, dislike, or find interesting. my letterboxd is full of jokes except for the one-off serious thing, and i don't use rym to review stuff.</p>
    				<ul class="post-list" role="list">
    					{reviews.map((review: any) =>
    						<li>
    							<p class="post-title"><a href={review.url}>{review.frontmatter.title}</a></p>
    							<p>{review.frontmatter.datePublish.slice(0, 10)}</p>
    						</li>
    					)}
    				</ul>
				</div>
			</section>
			<section>
				<h2 class="outlink"><a href="/works/">works</a></h2>
				<div class="works">
    				<p>here's some stuff i've worked on. it's mostly sheet music, but i'll probably put some other stuff here later.</p>
    				<ul class="post-list" role="list">
    					{works.map((work: any) =>
    						<li>
    							<p class="post-title"><a href={work.url}>{work.frontmatter.title}</a></p>
    							<p>{work.frontmatter.datePublish.slice(0, 10)}</p>
    						</li>
    					)}
    				</ul>
				</div>
			</section>
		</div>
	</main>
	<script defer is:inline>
		let user = 'sareau';
		let url = 'https://lastfm-last-played.biancarosa.com.br/' + user + '/latest-song';
		let song = document.querySelector('.song');
		let artist = document.querySelector('.artist');
		fetch(url)
			.then(function (response) {
				return response.json()
			}).then(function (json) {
				song.innerHTML = `<a href='${json['track']['url']}'>${json['track']['name']}</a>`;
				artist.innerHTML = `by ${json['track']['artist']['#text']}`;
			});
	</script>
</Layout>

<style>
	main {
		/*margin-top: calc(var(--spacer4) - calc(var(--spacer1) * 2));*/
		margin-bottom: calc(var(--spacer4) - var(--spacer1));
		padding: var(--spacer0);
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: var(--spacer0);
	}
	h1, h2 {
		font-weight: bold;
	}
    .hero {
        background-image: url(/assets/hero.webp);
        background-size: cover;
        background-position: center;
        padding: var(--spacer0);
        border-block-end: 1px solid var(--color-foreground);
        height: calc(var(--spacer4) * 3);
        dispay: grid;
        align-content: end;
    }
    .hero .welcome {
        background-color: var(--color-background);
        padding: var(--spacer0);
        border: 1px solid var(--color-foreground);
        width: max-content;
    }
	.side {
		grid-column: 1 / 3;
	}
	.main {
		grid-column: 3 / -1;
	}
	section {
		background-color: var(--color-background);
        padding: var(--spacer0);
        border: 1px solid var(--color-foreground);
	}
	/*section > * + * {
		margin-top: var(--spacer1);
	}*/
	section + section {
		margin-top: var(--spacer0);
	}
	/*.main section p {
		text-align: justify;
	}*/
	/*#statuscafe-content {
		margin-top: var(--spacer1);
	}*/
	.button-container {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--spacer1);
	}
	.button-container textarea {
		border: 0;
		background-color: var(--color-background);
		color: var(--color-foreground);
		resize: none;
		font-size: 50%;
	}
	.about {
		display: block;
	}
	.about-content > * + * {
		margin-top: var(--spacer1);
	}
	.profiles {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacer0);
		list-style: none;
	}
	.profiles li + li {
		margin-top: 0;
	}
	.about-persona {
	    margin-top: var(--spacer1);
		border: 1px solid var(--color-foreground);
	}
	.about-persona img {
		max-height: 50vh;
		margin-inline: auto;
	}
	.about-persona figcaption {
		border-top: 1px solid var(--color-foreground);
		padding: 0.5rem;
		text-align: center;
	}
	.blog > * + * {
		margin-top: var(--spacer1);
	}
	.outlink a {
		text-decoration: none;
	}
	.outlink a::after {
		content: " \2197";
	}
	.post-list {
		list-style: none;
	}
	.post-list li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--spacer1);
	}
	.post-list li + li {
		margin-top: var(--spacer1);
	}
	.post-list li .post-title {
		width: 100%;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		text-transform: lowercase;
	}
	.interests > * + * {
		margin-top: var(--spacer1);
	}
	.favorites > * + * {
		margin-top: var(--spacer1);
	}
    .favorites-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--spacer0);
    }
	.favorites-grid > :last-child {
		display: none;
	}
	.reviews > * + *, .works > * + * {
		margin-top: var(--spacer1);
	}
	.neighbors {
	    margin-block-start: var(--spacer0);
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacer0);
	}
	.neighbors img {
		height: 31px;
		width: 88px;
	}
	@media (width < 32rem) {
		main {
			display: block;
		}
		.main {
			margin-top: var(--spacer4);
		}
        .favorites-grid {
            grid-template-columns: repeat(3, 1fr);
        }
		.favorites-grid > :last-child {
			display: initial;
		}
	}
</style>
